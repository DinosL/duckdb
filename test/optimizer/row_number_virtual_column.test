statement ok
pragma disable_optimizer;

statement ok
CREATE OR REPLACE TABLE foo AS SELECT range a FROM range(100);

statement ok
DELETE FROM foo where a % 5 = 0;

statement ok
pragma enable_optimizer;

# SELECT a, row_number FROM (select a, row_number from foo where row_number > 10 order by hash(rowid + 32)) limit 5;
query II
select a, row_number from foo where a > 50 and row_number > 10 limit 5;
----
51	41
52	42
53	43
54	44
56	45


# statement ok
# CREATE TABLE t1 AS SELECT range AS id, range * 10 AS a FROM range(1, 11);
#
# statement ok
# CREATE TABLE t2 AS SELECT range AS id, range + 5 AS b FROM range(5, 16);
#
# query II
# SELECT t1.a, t2.b, row_number FROM t1 JOIN t2 ON t1.id = t2.id;
# ----

statement ok
create or replace table tbl1 as select range a from range(100);

query I
SELECT SUM(row_number) AS total_row_numbers FROM tbl1;
----
5050

query II
SELECT a, row_number FROM tbl1 ORDER BY a limit 3;
----
0	1
1	2
2	3

query II
SELECT a, row_number FROM tbl1 ORDER BY row_number limit 3;
----
0	1
1	2
2	3

query II
SELECT a, row_number FROM tbl1 ORDER BY a DESC limit 3;
----
99	3
98	2
97	1

query II
SELECT a, row_number FROM tbl1 ORDER BY row_number DESC limit 3;
----
99	3
98	2
97	1

