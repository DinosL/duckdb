query III
SELECT * FROM (SELECT a.a, b.b FROM t1 a JOIN t2 b ON a.a = b.b) AS join12
  JOIN t3 on join12.a = t3.c LIMIT 5;
----
5	5	5
6	6	6
7	7	7
8	8	8
9	9	9

mode skip

query III
SELECT * FROM t1 AS join12
   JOIN (SELECT c.c, d.d as newD FROM t3 c JOIN t4 d ON c.c = d.d) AS join34 ON join12.a = join34.c;
