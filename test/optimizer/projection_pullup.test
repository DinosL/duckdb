query II
SELECT SUM(v1.i) + SUM(v2.i) AS sum_i, SUM(v1.j) + SUM(v2.j) AS sum_j
FROM (VALUES (1, 10), (2, 5), (3, 4)) AS v1(i, j)
JOIN (VALUES (1, 10), (2, 5), (3, 4)) AS v2(i, j) ON v1.i = v2.i;
----
12	38

