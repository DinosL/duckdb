# name: test/optimizer/test.test
# description: Test projection Pull Up
# group: [optimizer]

statement ok
pragma disable_optimizer

statement ok
create table t1 as select range i from range(10);

statement ok
create table t2 as select range i from range(100);

statement ok
create view v1 as select i, i * 42 j from t1 join t2 using (i);

statement ok
PRAGMA explain_output = OPTIMIZED_ONLY;

statement ok
pragma enable_optimizer;

statement ok
set disabled_optimizers to 'common_subplan,column_lifetime,compressed_materialization,statistics_propagation';

query II
explain select i, j1.j from v1 j1 join v1 j2 using (i);
